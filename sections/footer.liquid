

{% liquid
  assign miranda_footer_style = true
  if section.settings.miranda_footer_style == false
    assign miranda_footer_style = false
  endif

  if section.settings.background_color != blank
    render 'contrast-override', background_color: section.settings.background_color, section_id: section.id
  endif
%}

<div
  class="section-background{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"
></div>
<div
  class="section section--{{ section.settings.section_width }}{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}{% if miranda_footer_style %} footer--miranda{% endif %}"
>
  {% liquid
    assign total_blocks = section.blocks.size

    # Grid layout calculations
    assign grid_columns = total_blocks | at_most: 4

    # Calculate last row counts using modulo arithmetic
    # last_row_count = (total_blocks - 1) % N + 1
    assign last_row_count = total_blocks | minus: 1 | modulo: 4 | plus: 1
    assign tablet_last_row_count = total_blocks | minus: 1 | modulo: 2 | plus: 1

    # Check if there are orphaned elements (single item in last row)
    assign has_isolated_grid_item_desktop = false
    assign has_isolated_grid_item_tablet = false

    if total_blocks > 4 and last_row_count == 1
      assign has_isolated_grid_item_desktop = true
    endif

    if total_blocks == 5
      assign has_isolated_grid_item_tablet = true
    endif
  %}
  <div
    class="
      footer-content
      spacing-style
      {% if has_isolated_grid_item_desktop %}footer-content--isolated-grid-item-desktop{% endif %}
      {% if has_isolated_grid_item_tablet %}footer-content--isolated-grid-item-tablet{% endif %}
    "
    style="
      {%  render 'spacing-style', settings: section.settings %}
      --footer-gap: {{ section.settings.gap }}px;
      --grid-columns: {{ grid_columns }};
      --last-row-count: {{ last_row_count }};
      --tablet-last-row-count: {{ tablet_last_row_count }};
    "
  >
    {% content_for 'blocks' %}
  </div>
</div>

{% stylesheet %}
  .footer-content {
    contain: content;
    content-visibility: auto;
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--footer-gap);
    align-items: start;
  }

  .footer--miranda {
    --miranda-footer-text: #24201f;
    --miranda-footer-muted: rgb(36 32 31 / 0.66);
    --miranda-footer-accent: #ffadbe;
    background: #fffaf8;
    color: var(--miranda-footer-text);
  }

  .footer--miranda .footer-content {
    gap: clamp(32px, 5vw, 72px);
  }

  .footer--miranda :is(p, h1, h2, h3, h4, h5, h6) {
    color: inherit;
  }

  .footer--miranda .logo-block {
    margin-block-end: 14px;
  }

  .footer--miranda .logo-block__image-wrapper {
    max-width: 180px;
  }

  .footer--miranda .text-block {
    color: var(--miranda-footer-muted);
    line-height: 1.55;
  }

  .footer--miranda .menu__heading {
    min-height: 44px;
    color: var(--miranda-footer-text);
    font-size: 0.75rem;
    font-weight: 650;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .footer--miranda .menu__item {
    color: var(--miranda-footer-muted);
    font-size: 0.92rem;
    line-height: 1.45;
  }

  .footer--miranda a {
    color: inherit;
    text-decoration: none;
    transition: color var(--animation-speed) var(--ease-out-cubic);
  }

  .footer--miranda a:hover {
    color: var(--miranda-footer-accent);
  }

  .footer--miranda .social-icons__wrapper {
    gap: 12px;
    margin-block-start: 18px;
  }

  .footer--miranda .social-icons__icon-wrapper {
    height: 34px;
    min-width: 34px;
  }

  .footer--miranda .social-icons__icon {
    width: 20px;
    height: 20px;
  }

  .footer-content .menu__heading__default {
    font-weight: var(--font-heading--weight);
  }

  @media screen and (min-width: 750px) and (max-width: 989px) {
    .footer-content {
      grid-template-columns: repeat(min(var(--grid-columns), 3), 1fr);
      grid-auto-flow: row;
    }

    .footer-content[style*='--grid-columns: 4'] {
      grid-template-columns: repeat(2, 1fr);
    }

    .footer-content--isolated-grid-item-tablet > :last-child {
      grid-column: 1 / -1;
    }
  }

  @media screen and (min-width: 990px) {
    .footer-content {
      grid-template-columns: repeat(var(--grid-columns), 1fr);
    }

    .footer--miranda .footer-content {
      grid-template-columns: minmax(230px, 1.25fr) repeat(3, minmax(0, 1fr));
    }

    /* Single item centered */
    .footer-content[style*='--grid-columns: 1'] {
      justify-items: center;
    }

    .footer-content--isolated-grid-item-desktop > :last-child {
      grid-column: 1 / -1;
    }
  }

  @media screen and (max-width: 749px) {
    .footer--miranda .footer-content {
      gap: 18px;
    }

    .footer--miranda .footer-content > :first-child {
      margin-block-end: 16px;
    }

    .footer--miranda .menu__details {
      border-block-start: 1px solid rgb(36 32 31 / 0.1);
    }

    .footer--miranda .menu__details summary {
      min-height: 52px;
      display: flex;
      align-items: center;
      justify-content: space-between;
    }

    .footer--miranda .menu--accordion .details-content {
      margin-block-start: 0;
      padding-block-end: 18px;
    }
  }
{% endstylesheet %}

