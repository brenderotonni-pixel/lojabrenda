{% liquid
  assign show_section = section.settings.show_section
  assign accent_color = section.settings.accent_color | default: '#FFADBE'
  assign text_color = section.settings.text_color | default: '#ffffff'
  assign email_placeholder = section.settings.placeholder | strip

  if email_placeholder == blank or email_placeholder == 'Seu melhor e-mail'
    assign email_placeholder = 'Seu e-mail'
  endif
%}

{% if show_section %}
  <section
    class="miranda-newsletter"
    style="
      --miranda-newsletter-bg: {{ accent_color }};
      --miranda-newsletter-text: {{ text_color }};
    "
  >
    <div class="miranda-newsletter__inner">
      <div class="miranda-newsletter__content">
        {% if section.settings.eyebrow != blank %}
          <p class="miranda-newsletter__eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {% endif %}

        {% if section.settings.heading != blank %}
          <h2 class="miranda-newsletter__heading">{{ section.settings.heading | newline_to_br }}</h2>
        {% endif %}

        {% if section.settings.description != blank %}
          <p class="miranda-newsletter__description">{{ section.settings.description | escape }}</p>
        {% endif %}
      </div>

      <div class="miranda-newsletter__form-wrap">
        {% assign form_id = 'MirandaNewsletter-' | append: section.id %}

        {% form 'customer', id: form_id, class: 'miranda-newsletter__form' %}
          <input type="hidden" name="contact[tags]" value="newsletter">

          <div class="miranda-newsletter__field">
            <label class="visually-hidden" for="MirandaNewsletterEmail-{{ section.id }}">
              {{ email_placeholder | escape }}
            </label>
            <input
              id="MirandaNewsletterEmail-{{ section.id }}"
              class="miranda-newsletter__input"
              type="email"
              name="contact[email]"
              autocorrect="off"
              autocapitalize="off"
              autocomplete="email"
              placeholder="{{ email_placeholder | escape }}"
              required
              {% if form.errors %}
                aria-invalid="true"
                aria-describedby="MirandaNewsletterError-{{ section.id }}"
                autofocus
              {% elsif form.posted_successfully? %}
                aria-describedby="MirandaNewsletterSuccess-{{ section.id }}"
              {% endif %}
            >
          </div>

          <button class="miranda-newsletter__button" type="submit">
            {{ section.settings.button_label | default: 'QUERO RECEBER →' | escape }}
          </button>

          {% if form.errors %}
            <div id="MirandaNewsletterError-{{ section.id }}" class="miranda-newsletter__message" tabindex="-1">
              {{ form.errors.translated_fields.email | capitalize }}
              {{ form.errors.messages.email }}
            </div>
          {% endif %}

          {% if form.posted_successfully? %}
            <div id="MirandaNewsletterSuccess-{{ section.id }}" class="miranda-newsletter__message" tabindex="-1">
              Obrigada. Seu cadastro foi recebido.
            </div>
          {% endif %}
        {% endform %}
      </div>
    </div>
  </section>
{% endif %}

{% stylesheet %}
  .miranda-newsletter {
    background: var(--miranda-newsletter-bg);
    color: var(--miranda-newsletter-text);
    padding-block: clamp(56px, 6vw, 88px);
  }

  .miranda-newsletter__inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(320px, 520px);
    align-items: center;
    gap: clamp(36px, 6vw, 96px);
    width: min(100% - 32px, 1240px);
    margin-inline: auto;
  }

  .miranda-newsletter__content {
    display: grid;
    gap: 14px;
  }

  .miranda-newsletter__eyebrow {
    margin: 0;
    font-size: 0.76rem;
    font-weight: 600;
    line-height: 1.3;
    letter-spacing: 0.22em;
    text-transform: uppercase;
  }

  .miranda-newsletter__heading {
    margin: 0;
    max-width: 13ch;
    font-family: Didot, 'Bodoni 72', 'Bodoni 72 Smallcaps', Baskerville, 'Cormorant Garamond',
      'Playfair Display', Georgia, serif;
    font-size: clamp(2.5rem, 4vw, 5rem);
    font-weight: 400;
    line-height: 0.98;
    letter-spacing: 0;
  }

  .miranda-newsletter__description {
    margin: 0;
    max-width: 34rem;
    font-size: clamp(0.98rem, 1.1vw, 1.1rem);
    line-height: 1.58;
  }

  .miranda-newsletter__form {
    display: grid;
    gap: 12px;
  }

  .miranda-newsletter__input,
  .miranda-newsletter__button {
    width: 100%;
    min-height: 58px;
    border: 1px solid rgb(255 255 255 / 0.52);
    border-radius: 0;
    font: inherit;
  }

  .miranda-newsletter__input {
    padding-inline: 20px;
    background: rgb(255 255 255 / 0.16);
    color: #24201f;
  }

  .miranda-newsletter__input::placeholder {
    color: rgb(36 32 31 / 0.55);
    opacity: 1;
  }

  .miranda-newsletter__input:focus-visible,
  .miranda-newsletter__button:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 3px;
  }

  .miranda-newsletter__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding-inline: 22px;
    background: #fff;
    color: #24201f;
    cursor: pointer;
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    box-shadow: 0 12px 24px rgb(36 32 31 / 0.08);
    transition:
      transform 220ms var(--ease-out-cubic),
      background-color 220ms var(--ease-out-cubic),
      box-shadow 220ms var(--ease-out-cubic);
    will-change: transform;
  }

  .miranda-newsletter__button:hover {
    transform: translateY(-2px);
    background: rgb(255 255 255 / 0.92);
    box-shadow: 0 16px 32px rgb(36 32 31 / 0.12);
  }

  .miranda-newsletter__button:active {
    transform: translateY(1px) scale(0.985);
    background: rgb(255 255 255 / 0.86);
    box-shadow: 0 7px 16px rgb(36 32 31 / 0.1);
  }

  .miranda-newsletter__message {
    font-size: 0.9rem;
    line-height: 1.45;
  }

  @media (prefers-reduced-motion: reduce) {
    .miranda-newsletter__button {
      transition: none;
      will-change: auto;
    }

    .miranda-newsletter__button:hover,
    .miranda-newsletter__button:active {
      transform: none;
    }
  }

  @media screen and (max-width: 749px) {
    .miranda-newsletter {
      padding-block: 52px 58px;
    }

    .miranda-newsletter__inner {
      grid-template-columns: 1fr;
      gap: 28px;
    }

    .miranda-newsletter__heading {
      max-width: 12ch;
      font-size: clamp(2.2rem, 11vw, 3.8rem);
    }

    .miranda-newsletter__input,
    .miranda-newsletter__button {
      min-height: 54px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Newsletter Miranda",
  "tag": "section",
  "enabled_on": {
    "groups": ["footer"]
  },
  "settings": [
    {
      "type": "checkbox",
      "id": "show_section",
      "label": "Mostrar newsletter",
      "default": true
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "FIQUE POR DENTRO"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Headline",
      "default": "Um pouco de Miranda\ndireto para você."
    },
    {
      "type": "text",
      "id": "description",
      "label": "Descrição",
      "default": "Novidades, lançamentos e condições especiais no seu e-mail."
    },
    {
      "type": "text",
      "id": "placeholder",
      "label": "Placeholder do campo",
      "default": "Seu e-mail"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Texto do botão",
      "default": "QUERO RECEBER →"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Cor de fundo",
      "default": "#FFADBE"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Cor do texto",
      "default": "#FFFFFF"
    }
  ],
  "presets": [
    {
      "name": "Newsletter Miranda",
      "category": "Rodapé"
    }
  ]
}
{% endschema %}
