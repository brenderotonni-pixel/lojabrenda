          }
        },
        {
          "type": "look",
          "settings": {
            "username": "@miranda",
            "caption": "Peças para o seu momento"
          }
        },
        {
          "type": "look",
          "settings": {
            "username": "@miranda",
            "caption": "Vista o que combina com você"
          }
        }
      ]
    }
  ]
}
{% endschema %}
