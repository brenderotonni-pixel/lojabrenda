          "id": "caption",
          "label": "Legenda curta"
        }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "#VistaMiranda",
      "category": "Imagem",
      "blocks": [
        {
          "type": "look",
          "settings": {
            "username": "@miranda",
